# Local AI backend configuration (copy: `cp .env.example .env`).
# NEVER commit a real key. `.env` is gitignored.
#
# Server key for Unlayer Cloud API (server-to-server). The project ID is
# embedded in this key — no projectId needed.
# Get one from the Unlayer console. AI features consume AI credits.
UNLAYER_API_KEY=
#
# Only needed for Personal Access Tokens (unlayer_pat_*), which require
# workspace admin operations. Leave empty for API keys.
UNLAYER_PROJECT_ID=
#
# Local port the AI backend listens on (loopback only).
AI_SERVER_PORT=5198
#
# BYOM provider: GroqCloud (M8). Free-tier key from https://console.groq.com.
# The key stays in this file / process env — it is never sent to the browser.
GROQ_API_KEY=
#
# Groq chat model. Must support structured outputs (strict json_schema).
# Verified 2026-10-23 against the official Groq docs + live /models list:
#   openai/gpt-oss-20b (default), openai/gpt-oss-120b, qwen/qwen3.8-27b.
GROQ_MODEL=openai/gpt-oss-20b
